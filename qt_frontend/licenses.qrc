<!DOCTYPE RCC>
<RCC version="1.0">
<qresource prefix="/licenses">
    <!-- Track N Race is GPLv3; retain the existing canonical license copy. -->
    <file alias="GPL-3.0.txt">src/third_party/qcustomplot/GPL.txt</file>
    <file alias="LGPL-3.0.txt">licenses/LGPL-3.0.txt</file>
    <file alias="LGPL-2.1.txt">licenses/LGPL-2.1.txt</file>
    <file alias="GPL-2.0.txt">licenses/GPL-2.0.txt</file>
    <!-- MIT is used by several components with different copyright holders; each
         gets its own file so the displayed notice matches (MIT requires the
         copyright notice to be reproduced verbatim). qt-toast is a fork; its file
         notes that and reproduces the upstream notice. -->
    <file alias="MIT-glaze.txt">licenses/MIT-glaze.txt</file>
    <file alias="MIT-qt-toast.txt">licenses/MIT-qt-toast.txt</file>
    <file alias="Zlib.txt">licenses/Zlib.txt</file>
    <file alias="BSD-3-Clause-Zstandard.txt">licenses/BSD-3-Clause-Zstandard.txt</file>
    <!-- libxlsxwriter (the Excel export engine) is BSD 2-Clause; its own license
         file also reproduces the notices for its bundled minizip/tmpfileplus/md5. -->
    <file alias="BSD-2-Clause-libxlsxwriter.txt">licenses/BSD-2-Clause-libxlsxwriter.txt</file>
    <!-- Noto Sans (bundled under fonts.qrc) ships under the SIL Open Font
         License 1.1; the OFL requires the licence to accompany the font. -->
    <file alias="OFL-1.1-Noto.txt">licenses/OFL-1.1-Noto.txt</file>
</qresource>
</RCC>
