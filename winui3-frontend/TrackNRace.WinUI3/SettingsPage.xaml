<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrackNRace.WinUI3.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                Margin="0,28,0,48"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Appearance" />

                    <toolkit:SettingsCard
                        HorizontalAlignment="Stretch"
                        Description="Choose the color theme used throughout Track N Race."
                        Header="Theme">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <RadioButtons
                            x:Name="ThemeRadioButtons"
                            AutomationProperties.Name="App theme"
                            MaxColumns="2"
                            SelectionChanged="OnThemeSelectionChanged">
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </RadioButtons>
                    </toolkit:SettingsCard>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
