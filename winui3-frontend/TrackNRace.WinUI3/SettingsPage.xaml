<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrackNRace.WinUI3.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                Margin="0,28,0,48"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Appearance" />

                    <toolkit:SettingsCard
                        HorizontalAlignment="Stretch"
                        Description="Choose the color theme used throughout Track N Race."
                        Header="Theme">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="ThemeComboBox"
                            AutomationProperties.Name="App theme"
                            SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                            <ComboBoxItem Content="Use system setting" Tag="Default" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalAlignment="Stretch"
                        Description="Choose the material used behind the app content."
                        Header="Window backdrop">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE771;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="BackdropComboBox"
                            Width="160"
                            AutomationProperties.Name="Window backdrop"
                            SelectionChanged="OnBackdropSelectionChanged">
                            <x:String>Mica</x:String>
                            <x:String>Mica Alt</x:String>
                            <x:String>Acrylic</x:String>
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalAlignment="Stretch"
                        Description="Make the NavigationView content background transparent with a subtle divider border."
                        Header="Transparent content pane">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7B8;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="TransparentNavigationContentToggle"
                            AutomationProperties.Name="Transparent NavigationView content pane"
                            Toggled="OnTransparentNavigationContentToggled" />
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Overview page" />

                    <toolkit:SettingsCard
                        Description="Show the eleven live statistics as a dense single-line strip."
                        Header="Compact statistics">
                        <ToggleSwitch
                            x:Name="CompactOverviewStatsToggle"
                            Toggled="OnOverviewDisplaySettingChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Show the Overview damage values as a dense single-line strip."
                        Header="Compact damage cards">
                        <ToggleSwitch
                            x:Name="CompactOverviewDamageToggle"
                            Toggled="OnOverviewDisplaySettingChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Choose the amount of detail and height used by the four tyre cards."
                        Header="Tyre card density">
                        <ComboBox
                            x:Name="OverviewTyreDensityComboBox"
                            Width="160"
                            SelectionChanged="OnOverviewDisplaySettingChanged">
                            <x:String>Normal</x:String>
                            <x:String>Compact 1</x:String>
                            <x:String>Compact 2</x:String>
                            <x:String>Compact 3</x:String>
                            <x:String>Compact 4</x:String>
                            <x:String>Compact 5</x:String>
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Show current tyre cards or the four rolling tyre-history charts."
                        Header="Tyre display">
                        <ComboBox
                            x:Name="OverviewTyreViewComboBox"
                            Width="160"
                            SelectionChanged="OnOverviewDisplaySettingChanged">
                            <x:String>Cards</x:String>
                            <x:String>Graphs</x:String>
                        </ComboBox>
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Power page" />

                    <toolkit:SettingsCard
                        Description="Show the seven Power statistics as a dense single-line strip."
                        Header="Compact info cards">
                        <ToggleSwitch
                            x:Name="CompactPowerCardsToggle"
                            Toggled="OnPowerDisplaySettingChanged" />
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Tyres page" />

                    <toolkit:SettingsCard
                        Description="Choose whether the fourth Tyres graph shows used tread or remaining tyre life."
                        Header="Wear chart">
                        <ComboBox
                            x:Name="TyreWearModeComboBox"
                            Width="160"
                            AutomationProperties.Name="Tyre wear chart mode"
                            SelectionChanged="OnTyreWearModeChanged">
                            <x:String>Tyre life</x:String>
                            <x:String>Tyre wear</x:String>
                        </ComboBox>
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Session page" />

                    <toolkit:SettingsCard
                        Description="Reduce the height and typography of the Session header."
                        Header="Compact header">
                        <ToggleSwitch
                            x:Name="CompactSessionHeaderToggle"
                            Toggled="OnSessionDisplaySettingChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Show the nine Session statistics as a dense single-line strip."
                        Header="Compact info cards">
                        <ToggleSwitch
                            x:Name="CompactSessionCardsToggle"
                            Toggled="OnSessionDisplaySettingChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Controls the height and detail shown in the weather forecast strip."
                        Header="Weather density">
                        <ComboBox
                            x:Name="SessionWeatherDensityComboBox"
                            Width="210"
                            SelectionChanged="OnSessionDisplaySettingChanged">
                            <x:String>Normal</x:String>
                            <x:String>Compact with icons</x:String>
                            <x:String>Compact without icons</x:String>
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Colour each track sector separately."
                        Header="Sector colours">
                        <ToggleSwitch
                            x:Name="SessionSectorColorsToggle"
                            Toggled="OnSessionDisplaySettingChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Reduce the visual prominence of the track beneath driver markers."
                        Header="Dim track map">
                        <ToggleSwitch
                            x:Name="SessionMapDimmedToggle"
                            Toggled="OnSessionDisplaySettingChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Choose how cars are identified on the track map."
                        Header="Driver markers">
                        <ComboBox
                            x:Name="SessionDriverModeComboBox"
                            Width="180"
                            SelectionChanged="OnSessionDisplaySettingChanged">
                            <x:String>Dots</x:String>
                            <x:String>Dots and labels</x:String>
                            <x:String>Labels</x:String>
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Hide a non-player car after its position stops changing. Set to 0 to disable."
                        Header="Stale-car timeout">
                        <NumberBox
                            x:Name="SessionStaleTimeoutNumberBox"
                            Width="130"
                            Header="Seconds"
                            Maximum="120"
                            Minimum="0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="OnSessionDisplayNumberChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="Disable map camera easing and other decorative Session animations."
                        Header="Reduce animations">
                        <ToggleSwitch
                            x:Name="SessionReduceAnimationsToggle"
                            Toggled="OnSessionDisplaySettingChanged" />
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Telemetry" />

                    <toolkit:SettingsCard
                        HorizontalAlignment="Stretch"
                        Description="The local address and UDP port libtnrp listens on."
                        Header="UDP listener">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE968;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="BindAddressTextBox"
                                Width="150"
                                AutomationProperties.Name="Bind address"
                                Header="Bind address" />
                            <NumberBox
                                x:Name="UdpPortNumberBox"
                                Width="130"
                                AutomationProperties.Name="UDP port"
                                Header="UDP port"
                                Maximum="65535"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        HorizontalAlignment="Stretch"
                        Description="Auto detects the game year, or forces a specific packet format."
                        Header="Protocol">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D4;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="ProtocolComboBox"
                            Width="160"
                            AutomationProperties.Name="Telemetry protocol">
                            <x:String>Auto detect</x:String>
                            <x:String>F1 24</x:String>
                            <x:String>F1 25</x:String>
                            <x:String>F1 26</x:String>
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <Button
                        HorizontalAlignment="Right"
                        Click="OnApplyTelemetrySettings"
                        Content="Apply telemetry settings"
                        Style="{StaticResource AccentButtonStyle}" />

                    <InfoBar
                        x:Name="TelemetrySettingsInfo"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
