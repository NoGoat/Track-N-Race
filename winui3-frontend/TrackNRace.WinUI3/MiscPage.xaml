<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrackNRace.WinUI3.MiscPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charting="using:TrackNRace.Charting"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ActualThemeChanged="OnActualThemeChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style
            x:Key="ChartHeadingStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ChartLegendStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="ChartEmptyStateStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="GForceRow" Height="*" />
            <RowDefinition x:Name="SectionDividerRow" Height="1" />
            <RowDefinition x:Name="RideHeightRow" Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="GForceSection">
            <Grid Padding="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource ChartHeadingStyle}"
                        Text="G-FORCE" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle
                                Width="12"
                                Height="2"
                                VerticalAlignment="Center"
                                Fill="#F0A500"
                                RadiusX="1"
                                RadiusY="1" />
                            <TextBlock
                                Style="{StaticResource ChartLegendStyle}"
                                Text="Lateral" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle
                                Width="12"
                                Height="2"
                                VerticalAlignment="Center"
                                Fill="#5794F2"
                                RadiusX="1"
                                RadiusY="1" />
                            <TextBlock
                                Style="{StaticResource ChartLegendStyle}"
                                Text="Longitudinal" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource ChartLegendStyle}"
                            Text="+ve = right / accel" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <charting:GpuChart x:Name="GForcePlot" />
                    <TextBlock
                        x:Name="GForceNoData"
                        Style="{StaticResource ChartEmptyStateStyle}"
                        Text="Waiting for telemetry" />
                </Grid>
            </Grid>
        </Border>

        <Border
            x:Name="SectionDivider"
            Grid.Row="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Border x:Name="RideHeightSection" Grid.Row="2">
            <Grid Padding="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource ChartHeadingStyle}"
                        Text="RIDE HEIGHT" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle
                                Width="12"
                                Height="2"
                                VerticalAlignment="Center"
                                Fill="#73BF69"
                                RadiusX="1"
                                RadiusY="1" />
                            <TextBlock
                                Style="{StaticResource ChartLegendStyle}"
                                Text="Front" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle
                                Width="12"
                                Height="2"
                                VerticalAlignment="Center"
                                Fill="#B877DB"
                                RadiusX="1"
                                RadiusY="1" />
                            <TextBlock
                                Style="{StaticResource ChartLegendStyle}"
                                Text="Rear" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource ChartLegendStyle}"
                            Text="plank edge above road" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <charting:GpuChart x:Name="RideHeightPlot" />
                    <TextBlock
                        x:Name="RideHeightNoData"
                        Style="{StaticResource ChartEmptyStateStyle}"
                        Text="Waiting for telemetry" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
