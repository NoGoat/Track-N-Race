<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TrackNRace.WinUI3.TyreChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottPlot="using:ScottPlot.WinUI"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="ChartHeadingStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ChartLegendStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ChartTooltipStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style
            x:Key="ChartTooltipTimeStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="ChartTooltipValueStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock" />
        <Style
            x:Key="ChartEmptyStateStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <TextBlock
                x:Name="Heading"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource ChartHeadingStyle}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle x:Name="FlLegend" Width="12" Height="2" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                    <TextBlock Style="{StaticResource ChartLegendStyle}" Text="FL" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle x:Name="FrLegend" Width="12" Height="2" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                    <TextBlock Style="{StaticResource ChartLegendStyle}" Text="FR" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle x:Name="RlLegend" Width="12" Height="2" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                    <TextBlock Style="{StaticResource ChartLegendStyle}" Text="RL" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle x:Name="RrLegend" Width="12" Height="2" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                    <TextBlock Style="{StaticResource ChartLegendStyle}" Text="RR" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <scottPlot:WinUIPlot
                x:Name="PlotControl"
                PointerExited="OnPointerExited"
                PointerMoved="OnPointerMoved" />
            <TextBlock
                x:Name="NoData"
                Style="{StaticResource ChartEmptyStateStyle}"
                Text="Waiting for telemetry" />
            <Canvas IsHitTestVisible="False">
                <Border x:Name="Tooltip" Style="{StaticResource ChartTooltipStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TooltipTime" Style="{StaticResource ChartTooltipTimeStyle}" />
                        <TextBlock Style="{StaticResource ChartTooltipValueStyle}">
                            <Run x:Name="TooltipFlLabel" Text="FL:" />
                            <Run x:Name="TooltipFlValue" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource ChartTooltipValueStyle}">
                            <Run x:Name="TooltipFrLabel" Text="FR:" />
                            <Run x:Name="TooltipFrValue" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource ChartTooltipValueStyle}">
                            <Run x:Name="TooltipRlLabel" Text="RL:" />
                            <Run x:Name="TooltipRlValue" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource ChartTooltipValueStyle}">
                            <Run x:Name="TooltipRrLabel" Text="RR:" />
                            <Run x:Name="TooltipRrValue" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
