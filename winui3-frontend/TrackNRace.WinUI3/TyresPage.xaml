<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrackNRace.WinUI3.TyresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TrackNRace.WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ActualThemeChanged="OnActualThemeChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TyreFittedBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
        <Style
            x:Key="TyreListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="SectionHeadingStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
        </Style>
        <Style
            x:Key="ColumnHeaderStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
        </Style>
        <Style
            x:Key="RowTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <DataTemplate
            x:Key="ConditionTemplate"
            x:DataType="local:TyreConditionViewModel">
            <Grid Padding="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{x:Bind Position}" />
                <Grid Grid.Row="2">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Surface" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind SurfaceBrush, Mode=OneWay}"
                        Text="{x:Bind Surface, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="4">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inner" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind InnerBrush, Mode=OneWay}"
                        Text="{x:Bind Inner, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="6">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Brake" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind BrakeBrush, Mode=OneWay}"
                        Text="{x:Bind Brake, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="7" Margin="0,10,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        Height="6"
                        VerticalAlignment="Center"
                        Foreground="{x:Bind WearBrush, Mode=OneWay}"
                        IsIndeterminate="False"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind WearValue, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind WearBrush, Mode=OneWay}"
                        Text="{x:Bind Wear, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate
            x:Key="TyreSectionTemplate"
            x:DataType="local:TyreSetGroupViewModel">
            <Border
                MinWidth="760"
                Height="32"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid Padding="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Style="{StaticResource SectionHeadingStyle}"
                        Text="{x:Bind Title}" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderStyle}" Text="WEAR" />
                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderStyle}" Text="LIFE" />
                    <TextBlock Grid.Column="6" HorizontalAlignment="Center" Style="{StaticResource ColumnHeaderStyle}" Text="REC." />
                    <TextBlock Grid.Column="7" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderStyle}" Text="Δ LAP" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="TyreRowTemplate"
            x:DataType="local:TyreSetRowViewModel">
            <Grid
                MinWidth="760"
                Height="34"
                Padding="10,0"
                AutomationProperties.Name="{x:Bind AutomationName}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Opacity="{x:Bind ContentOpacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.ColumnSpan="8"
                    Margin="-10,0"
                    Background="{StaticResource TyreFittedBackground}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind FittedVisibility}" />
                <TextBlock Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind SetNumber}" />
                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{x:Bind CompoundBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind Compound}" />
                <Border
                    Grid.Column="2"
                    Width="72"
                    Padding="5,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{x:Bind StatusBackground}"
                    BorderBrush="{x:Bind StatusBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind StatusBrush}"
                        Text="{x:Bind Status}" />
                </Border>
                <ProgressBar
                    Grid.Column="3"
                    Height="6"
                    Margin="8,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{x:Bind WearBrush}"
                    IsIndeterminate="False"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind WearValue}" />
                <TextBlock Grid.Column="4" HorizontalAlignment="Right" Foreground="{x:Bind WearBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind Wear}" />
                <TextBlock Grid.Column="5" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind Life}" />
                <TextBlock Grid.Column="6" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind Recommended}" />
                <TextBlock Grid.Column="7" HorizontalAlignment="Right" Foreground="{x:Bind DeltaBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind Delta}" />
            </Grid>
        </DataTemplate>
        <local:TyreTableTemplateSelector
            x:Key="TyreTableTemplateSelector"
            RowTemplate="{StaticResource TyreRowTemplate}"
            SectionTemplate="{StaticResource TyreSectionTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid x:Name="AllocationRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="TyreSetsList"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Tyre allocation"
                IsItemClickEnabled="False"
                ItemContainerStyle="{StaticResource TyreListViewItemStyle}"
                ItemTemplateSelector="{StaticResource TyreTableTemplateSelector}"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="None">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
            </ListView>

            <Border
                Grid.Column="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,0">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="CONDITIONS" />
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Show tyre graphs"
                            Click="OnShowGraphs"
                            Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE9D2;" />
                                <TextBlock Text="Graphs" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.FrontLeft}"
                            ContentTemplate="{StaticResource ConditionTemplate}" />
                        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <ContentControl
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind ViewModel.FrontRight}"
                                ContentTemplate="{StaticResource ConditionTemplate}" />
                        </Border>
                        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <ContentControl
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind ViewModel.RearLeft}"
                                ContentTemplate="{StaticResource ConditionTemplate}" />
                        </Border>
                        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                            <ContentControl
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind ViewModel.RearRight}"
                                ContentTemplate="{StaticResource ConditionTemplate}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="GraphsRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                Padding="16,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="TYRE CONDITIONS" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.FittedSummary, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.FittedSummaryVisibility, Mode=OneWay}" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Show tyre allocation"
                    Click="OnShowAllocation"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8A5;" />
                        <TextBlock Text="Allocation" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:TyreChartControl x:Name="SurfaceChart" />
                <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <local:TyreChartControl x:Name="InnerChart" Grid.Column="2" />
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <local:TyreChartControl x:Name="BrakeChart" Grid.Row="2" />
                <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <local:TyreChartControl x:Name="WearChart" Grid.Row="2" Grid.Column="2" />
            </Grid>
        </Grid>
    </Grid>
</Page>
