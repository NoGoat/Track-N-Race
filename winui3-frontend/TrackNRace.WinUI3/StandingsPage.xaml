<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrackNRace.WinUI3.StandingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TrackNRace.WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ActualThemeChanged="OnActualThemeChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="StandingsSelectionBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
        <Style
            x:Key="StandingsListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="ColumnHeaderStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
        </Style>
        <Style
            x:Key="RowTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="RailLabelStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <ListView
            x:Name="StandingsList"
            Grid.Column="0"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="Race standings"
            IsItemClickEnabled="True"
            ItemClick="OnStandingItemClicked"
            ItemContainerStyle="{StaticResource StandingsListViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionMode="Single">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.Header>
                <Border
                    MinWidth="990"
                    Height="32"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid Padding="10,0" ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeaderStyle}" Text="POS" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="DRIVER" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Text="LAP" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}" Text="LAST LAP" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderStyle}" Text="GAP" />
                        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeaderStyle}" Text="S1" />
                        <TextBlock Grid.Column="6" Style="{StaticResource ColumnHeaderStyle}" Text="S2" />
                        <TextBlock Grid.Column="7" Style="{StaticResource ColumnHeaderStyle}" Text="S3" />
                        <TextBlock Grid.Column="8" Style="{StaticResource ColumnHeaderStyle}" Text="TYRE" />
                    </Grid>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:StandingsRowViewModel">
                    <Grid
                        MinWidth="990"
                        Height="34"
                        Padding="10,0"
                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.ColumnSpan="10"
                            Margin="-10,0"
                            Background="{StaticResource StandingsSelectionBackground}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                        <Border
                            Grid.ColumnSpan="10"
                            Margin="-10,0"
                            Background="{x:Bind FastestBrush, Mode=OneWay}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="PositionFlashOverlay"
                            Grid.ColumnSpan="10"
                            Margin="-10,0"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <TextBlock
                            Grid.Column="0"
                            FontWeight="Bold"
                            Foreground="{x:Bind PositionBrush, Mode=OneWay}"
                            Style="{StaticResource RowTextStyle}"
                            Text="{x:Bind PositionText, Mode=OneWay}" />

                        <Grid Grid.Column="1" Margin="0,0,8,0" ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="4"
                                Height="20"
                                CornerRadius="2"
                                Background="{x:Bind TeamBrush, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind RaceNumber, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="2"
                                FontWeight="SemiBold"
                                Style="{StaticResource RowTextStyle}"
                                Text="{x:Bind DriverCode, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DriverName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind DriverName, Mode=OneWay}" />
                            <Border
                                Grid.Column="4"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="3"
                                Visibility="{x:Bind PlayerBadgeVisibility, Mode=OneWay}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="YOU" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind Lap, Mode=OneWay}" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Style="{StaticResource RowTextStyle}" Text="{x:Bind LastLap, Mode=OneWay}" />
                        <TextBlock Grid.Column="4" Foreground="{x:Bind GapBrush, Mode=OneWay}" Style="{StaticResource RowTextStyle}" Text="{x:Bind Gap, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind S1, Mode=OneWay}" />
                        <TextBlock Grid.Column="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind S2, Mode=OneWay}" />
                        <TextBlock Grid.Column="7" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource RowTextStyle}" Text="{x:Bind S3, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="8"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind TyreBrush, Mode=OneWay}"
                            Style="{StaticResource RowTextStyle}"
                            Text="{x:Bind Tyre, Mode=OneWay}" />

                        <ItemsControl
                            Grid.Column="9"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind Badges, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:StandingsBadgeViewModel">
                                    <Border
                                        Padding="5,1"
                                        Background="{x:Bind Background}"
                                        BorderBrush="{x:Bind BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind Foreground}"
                                            Text="{x:Bind Text}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Padding="16,14,16,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource RailLabelStyle}" Text="TIMING" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.Detail.DriverVisibility, Mode=OneWay}">
                                <Border
                                    Width="5"
                                    Height="18"
                                    CornerRadius="2"
                                    Background="{x:Bind ViewModel.Detail.TeamBrush, Mode=OneWay}" />
                                <TextBlock
                                    MaxWidth="150"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Detail.DriverName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Detail.LapLabel, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="{x:Bind ViewModel.Detail.Position, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Padding="7,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                BorderBrush="{x:Bind ViewModel.Detail.TimingBadgeBrush, Mode=OneWay}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{x:Bind ViewModel.Detail.TimingBadgeVisibility, Mode=OneWay}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ViewModel.Detail.TimingBadgeBrush, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Detail.TimingBadge, Mode=OneWay}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RailLabelStyle}" Text="CURRENT" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Detail.CurrentLap, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RailLabelStyle}" Text="LAST LAP" />
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Detail.LastLap, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid
                            Grid.Row="3"
                            Margin="-16,12,-16,0"
                            Padding="16,12,16,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource RailLabelStyle}" Text="S1" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Detail.S1, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource RailLabelStyle}" Text="S2" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Detail.S2, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource RailLabelStyle}" Text="S3" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Detail.S3, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Grid.Row="4"
                            Margin="0,8,0,0"
                            Foreground="#C4162A"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Detail.Penalty, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Detail.PenaltyVisibility, Mode=OneWay}" />
                    </Grid>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Padding="16,14" Spacing="12">
                        <TextBlock Style="{StaticResource RailLabelStyle}" Text="ENERGY RECOVERY" />
                        <Grid>
                            <TextBlock
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{x:Bind ViewModel.Detail.ErsBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.Detail.ErsPercent, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.Detail.ErsModeBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.Detail.ErsMode, Mode=OneWay}" />
                        </Grid>
                        <ProgressBar
                            Height="8"
                            Foreground="{x:Bind ViewModel.Detail.ErsBrush, Mode=OneWay}"
                            IsIndeterminate="False"
                            Maximum="100"
                            Value="{x:Bind ViewModel.Detail.ErsValue, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Detail.ErsEnergy, Mode=OneWay}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource RailLabelStyle}" Text="DEPLOYED" />
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Detail.ErsDeployed, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource RailLabelStyle}" Text="{x:Bind ViewModel.Detail.AeroLabel, Mode=OneWay}" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ViewModel.Detail.AeroBrush, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.Detail.AeroState, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Padding="16,14" Spacing="12">
                        <TextBlock Style="{StaticResource RailLabelStyle}" Text="STRATEGY" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailLabelStyle}" Text="FUEL" />
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="{x:Bind ViewModel.Detail.FuelBrush, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.Detail.Fuel, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="kg" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Detail.FuelLaps, Mode=OneWay}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.Detail.FuelMix, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Padding="16,14" Spacing="5">
                        <TextBlock Style="{StaticResource RailLabelStyle}" Text="TYRE" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{x:Bind ViewModel.Detail.TyreBrush, Mode=OneWay}"
                                Text="{x:Bind ViewModel.Detail.Tyre, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Detail.TyreAge, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Detail.BrakeBias, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
