<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrackNRace.WinUI3.InputsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottPlot="using:ScottPlot.WinUI"
    ActualThemeChanged="OnActualThemeChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style
            x:Key="ChartHeadingStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ChartLegendStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="ChartTooltipStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style
            x:Key="ChartTooltipTimeStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="ChartTooltipValueStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock" />
        <Style
            x:Key="ChartEmptyStateStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border>
                <Grid Padding="16,12,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,8"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource ChartHeadingStyle}"
                        Text="GEAR" />
                    <Grid Grid.Row="1">
                        <scottPlot:WinUIPlot
                            x:Name="GearPlot"
                            PointerExited="OnPlotPointerExited"
                            PointerMoved="OnGearPointerMoved" />
                        <TextBlock
                            x:Name="GearNoData"
                            Style="{StaticResource ChartEmptyStateStyle}"
                            Text="Waiting for telemetry" />
                        <Canvas IsHitTestVisible="False">
                            <Border
                                x:Name="GearTooltip"
                                Style="{StaticResource ChartTooltipStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="GearTooltipTimeText"
                                        Style="{StaticResource ChartTooltipTimeStyle}" />
                                    <TextBlock
                                        Style="{StaticResource ChartTooltipValueStyle}">
                                        <Run Foreground="#5794F2" Text="Gear" />
                                        <Run
                                            x:Name="GearTooltipValueRun"
                                            FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Border Grid.Column="2">
                <Grid Padding="12,12,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource ChartHeadingStyle}"
                            Text="THROTTLE / BRAKE" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle
                                    Width="12"
                                    Height="2"
                                    VerticalAlignment="Center"
                                    Fill="#37872D"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <TextBlock
                                    Style="{StaticResource ChartLegendStyle}"
                                    Text="Throttle" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle
                                    Width="12"
                                    Height="2"
                                    VerticalAlignment="Center"
                                    Fill="#C4162A"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <TextBlock
                                    Style="{StaticResource ChartLegendStyle}"
                                    Text="Brake" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <scottPlot:WinUIPlot
                            x:Name="ThrottleBrakePlot"
                            PointerExited="OnPlotPointerExited"
                            PointerMoved="OnThrottleBrakePointerMoved" />
                        <TextBlock
                            x:Name="ThrottleBrakeNoData"
                            Style="{StaticResource ChartEmptyStateStyle}"
                            Text="Waiting for telemetry" />
                        <Canvas IsHitTestVisible="False">
                            <Border
                                x:Name="ThrottleBrakeTooltip"
                                Style="{StaticResource ChartTooltipStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="ThrottleBrakeTooltipTimeText"
                                        Style="{StaticResource ChartTooltipTimeStyle}" />
                                    <TextBlock
                                        Style="{StaticResource ChartTooltipValueStyle}">
                                        <Run Foreground="#37872D" Text="Throttle:" />
                                        <Run
                                            x:Name="ThrottleBrakeTooltipThrottleValueRun"
                                            FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource ChartTooltipValueStyle}">
                                        <Run Foreground="#C4162A" Text="Brake:" />
                                        <Run
                                            x:Name="ThrottleBrakeTooltipBrakeValueRun"
                                            FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Border Grid.Row="2">
            <Grid Padding="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource ChartHeadingStyle}"
                        Text="STEERING" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle
                                Width="12"
                                Height="2"
                                VerticalAlignment="Center"
                                Fill="#BF5FFF"
                                RadiusX="1"
                                RadiusY="1" />
                            <TextBlock
                                Style="{StaticResource ChartLegendStyle}"
                                Text="Steering" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource ChartLegendStyle}"
                            Text="L = left · R = right" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <scottPlot:WinUIPlot
                        x:Name="SteeringPlot"
                        PointerExited="OnPlotPointerExited"
                        PointerMoved="OnSteeringPointerMoved" />
                    <TextBlock
                        x:Name="SteeringNoData"
                        Style="{StaticResource ChartEmptyStateStyle}"
                        Text="Waiting for telemetry" />
                    <Canvas IsHitTestVisible="False">
                        <Border
                            x:Name="SteeringTooltip"
                            Style="{StaticResource ChartTooltipStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="SteeringTooltipTimeText"
                                    Style="{StaticResource ChartTooltipTimeStyle}" />
                                <TextBlock
                                    Style="{StaticResource ChartTooltipValueStyle}">
                                    <Run Foreground="#BF5FFF" Text="Steering:" />
                                    <Run
                                        x:Name="SteeringTooltipValueRun"
                                        FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
