<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrackNRace.WinUI3.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrackNRace.WinUI3"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnUnloaded">
    <Page.Resources>
        <!-- Keep Session card/section titles identical to the Standings rail
             labels so both pages share one visual hierarchy. -->
        <Style
            x:Key="SessionSectionLabelStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
        </Style>
        <Style x:Key="SessionValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageLayout" ActualThemeChanged="OnActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto" />
            <RowDefinition x:Name="StatsRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="SessionHeader"
            MinHeight="68"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="TrackHeading"
                Padding="24,12"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="GrandPrixText"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="—"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="CircuitText"
                    Margin="0,2,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid
                Grid.Column="1"
                Padding="20,10"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Style="{StaticResource SessionSectionLabelStyle}" Text="ZONES" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="10" Height="10" Fill="#FDD835" /><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Yellow" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="10" Height="10" Fill="#00C853" /><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Green" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="10" Height="10" Fill="#2196F3" /><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Blue" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="10" Height="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" /><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Clear" /></StackPanel>
                    </StackPanel>
                </Grid>
                <Grid x:Name="MarshalZonesGrid" Grid.Row="1" Margin="0,8,0,0" Height="5" />
            </Grid>

            <StackPanel
                Grid.Column="2"
                Padding="20,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="TimeLeftLabel"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SessionSectionLabelStyle}"
                    Text="TIME LEFT" />
                <TextBlock
                    x:Name="TimeLeftText"
                    HorizontalAlignment="Right"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="--:--" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="StatsGrid"
            Grid.Row="1"
            MinHeight="72"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1" />

        <Grid x:Name="BodyGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RailColumn" Width="288" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="MapWeatherGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="WeatherRow" Height="90" />
                </Grid.RowDefinitions>
                <local:TrackMapControl
                    x:Name="TrackMap"
                    FullscreenRequested="OnMapFullscreenRequested" />
                <Grid
                    x:Name="WeatherGrid"
                    Grid.Row="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0" />
            </Grid>

            <Grid
                x:Name="RightRail"
                Grid.Column="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Padding="16,9" Style="{StaticResource SessionSectionLabelStyle}" Text="PROXIMITY" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="ProximityPanel" />
                </StackPanel>
                <Grid Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Padding="16,9" Style="{StaticResource SessionSectionLabelStyle}" Text="EVENTS" />
                    <ListView
                        x:Name="EventsList"
                        Grid.Row="1"
                        IsItemClickEnabled="False"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <StackPanel Padding="12,7">
                                        <TextBlock
                                            FontFamily="Cascadia Mono"
                                            FontSize="9"
                                            Foreground="{Binding Brush}"
                                            Text="{Binding Time}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Brush}"
                                            Text="{Binding Label}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="NoEventsText"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="No events yet" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
