<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrackNRace.WinUI3.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TrackNRace.WinUI3"
    xmlns:charting="using:TrackNRace.Charting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ActualThemeChanged="OnActualThemeChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style
            x:Key="OverviewSectionLabelStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="OverviewLegendStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="OverviewEmptyStateStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageLayout">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="StatsRow" Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition x:Name="TelemetryChartRow" Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition x:Name="TyreRow" Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition x:Name="DamageRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="StatsGrid" MinHeight="72" />
        <Border Grid.Row="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="2" Padding="16,10,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource OverviewSectionLabelStyle}"
                        Text="SPEED + RPM + ERS" />
                    <SelectorBar
                        x:Name="ChartModeSelector"
                        Padding="0"
                        VerticalAlignment="Center"
                        SelectionChanged="OnChartModeSelectionChanged">
                        <SelectorBarItem
                            x:Name="DefaultModeItem"
                            Padding="12,4,12,3"
                            Tag="Default"
                            Text="Default" />
                        <SelectorBarItem
                            Padding="12,4,12,3"
                            Tag="CurrentLap"
                            Text="Current Lap" />
                        <SelectorBarItem
                            Padding="12,4,12,3"
                            Tag="PreviousLap"
                            Text="Previous Lap" />
                        <SelectorBarItem
                            Padding="12,4,12,3"
                            Tag="FastestLap"
                            Text="Fastest Lap" />
                        <SelectorBarItem
                            x:Name="CompareModeItem"
                            Padding="12,4,12,3"
                            Tag="Compare"
                            Text="Compare Laps" />
                    </SelectorBar>
                    <ComboBox
                        x:Name="CompareLapComboBox"
                        Width="84"
                        Height="29"
                        MaxHeight="29"
                        MinHeight="0"
                        Padding="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Comparison lap"
                        PlaceholderText="Lap"
                        SelectionChanged="OnCompareLapChanged"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Rectangle Width="12" Height="2" VerticalAlignment="Center" Fill="#37872D" RadiusX="1" RadiusY="1" />
                        <TextBlock Style="{StaticResource OverviewLegendStyle}" Text="Speed (kph)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Rectangle Width="12" Height="2" VerticalAlignment="Center" Fill="#C4162A" RadiusX="1" RadiusY="1" />
                        <TextBlock Style="{StaticResource OverviewLegendStyle}" Text="RPM" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Rectangle Width="12" Height="2" VerticalAlignment="Center" Fill="#FADE2A" RadiusX="1" RadiusY="1" />
                        <TextBlock Style="{StaticResource OverviewLegendStyle}" Text="ERS (%)" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <charting:GpuChart x:Name="TelemetryPlot" />
                <TextBlock
                    x:Name="TelemetryNoData"
                    Style="{StaticResource OverviewEmptyStateStyle}"
                    Text="Waiting for telemetry" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Grid x:Name="TyreRegion" Grid.Row="4">
            <Grid x:Name="TyreCardsGrid" />
            <Grid x:Name="TyreGraphsGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:TyreChartControl x:Name="SurfaceChart" />
                <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <local:TyreChartControl x:Name="InnerChart" Grid.Column="2" />
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <local:TyreChartControl x:Name="BrakeChart" Grid.Row="2" />
                <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <local:TyreChartControl x:Name="WearChart" Grid.Row="2" Grid.Column="2" />
            </Grid>
        </Grid>
        <Border Grid.Row="5" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Grid x:Name="DamageGrid" Grid.Row="6" MinHeight="64" />
    </Grid>
</Page>
