<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile
      Include="..\..\TrackNRace.WinUI3\TelemetryEngine.cs"
      Link="TelemetryEngine.cs" />
    <Compile
      Include="..\..\TrackNRace.WinUI3\TelemetrySessionStore.cs"
      Link="TelemetrySessionStore.cs" />
    <Content
      Include="..\..\native\build\Debug\TrackNRace.EngineBridge.dll"
      Link="TrackNRace.EngineBridge.dll"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
