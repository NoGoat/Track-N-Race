<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="in.nogoat.tracknrace" path="/in/nogoat/tracknrace/">
    <key name="output-folder" type="s">
      <default>''</default>
      <summary>Recording folder</summary>
    </key>
    <key name="bind-address" type="s">
      <default>'0.0.0.0'</default>
      <summary>IPv4 bind address</summary>
    </key>
    <key name="port" type="u">
      <default>20777</default>
      <range min="1" max="65535"/>
      <summary>UDP port</summary>
    </key>
    <key name="protocol" type="s">
      <default>'auto'</default>
      <choices>
        <choice value="auto"/>
        <choice value="f1_24"/>
        <choice value="f1_25"/>
        <choice value="f1_26"/>
      </choices>
      <summary>Protocol override</summary>
    </key>
  </schema>
</schemalist>
