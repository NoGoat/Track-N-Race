<!DOCTYPE RCC>
<RCC version="1.0">
<qresource prefix="/licenses">
    <!-- GPLv3 covers the project itself and the vendored QCustomPlot; reuse the
         copy already in the tree rather than duplicating it. -->
    <file alias="GPL-3.0.txt">src/third_party/qcustomplot/GPL.txt</file>
    <file alias="LGPL-3.0.txt">licenses/LGPL-3.0.txt</file>
    <file alias="LGPL-2.1.txt">licenses/LGPL-2.1.txt</file>
    <file alias="GPL-2.0.txt">licenses/GPL-2.0.txt</file>
    <!-- MIT is used by two libraries with different copyright holders; each gets
         its own file so the displayed notice matches the library (MIT requires the
         copyright notice to be reproduced verbatim). -->
    <file alias="MIT-nlohmann.txt">licenses/MIT-nlohmann.txt</file>
    <file alias="MIT-glaze.txt">licenses/MIT-glaze.txt</file>
    <file alias="Zlib.txt">licenses/Zlib.txt</file>
</qresource>
</RCC>
