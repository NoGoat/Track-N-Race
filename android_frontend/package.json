{
  "name": "track-n-race-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "@swc/core@1.16.1": true,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
