  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "lucide-react": "1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-toastify": "11.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
