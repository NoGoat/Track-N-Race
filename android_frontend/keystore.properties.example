# Copy to keystore.properties (gitignored) and fill in. app/build.gradle reads
# it to sign release APKs. storeFile is relative to android_frontend/ unless
# absolute; keep the keystore itself outside the repository.
#
# The passwords are not stored here: build-signed-apk asks for them each run.
#
# Without this file, the build reads TNR_KEYSTORE_FILE and TNR_KEY_ALIAS from
# the environment instead.
storeFile=/path/to/jks/file
keyAlias=key-alias-name
