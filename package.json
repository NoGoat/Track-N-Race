{
  "name": "track-n-race",
  "version": "1.2.0",
  "description": "Track N Race",
  "author": "NoGoat",
  "main": "out/main/index.js",
  "scripts": {
    "build:bridge": "node scripts/build-bridge.mjs",
    "predev": "node scripts/gen-icon.mjs && node scripts/build-bridge.mjs",
    "prebuild": "node scripts/gen-icon.mjs && node scripts/build-bridge.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "prepack": "node scripts/build-bridge.mjs",
    "pack": "electron-builder --dir",
    "predist": "node scripts/build-bridge.mjs",
    "dist": "electron-builder",
    "dist:win:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.tracknrace.app",
    "productName": "Track N Race",
    "files": [
      "**/*",
      "!native_recorder${/*}",
      "!dist${/*}"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon_transparent.ico",
      "fileAssociations": [
        {
          "ext": "tnrd",
          "name": "Track N Race Session Data",
          "description": "Track N Race Recorded Telemetry Session Data",
          "role": "Viewer",
          "icon": "build/icon_transparent.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Track N Race",
      "installerIcon": "build/icon_transparent_light.ico",
      "uninstallerIcon": "build/icon_transparent_light.ico",
      "installerHeaderIcon": "build/icon_transparent_light.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "fileAssociations": [
        {
          "ext": "tnrd",
          "name": "Track N Race Session Data",
          "role": "Viewer"
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@track-n-race/timechart-engine": "file:src/renderer/src/lib/timechart/engine",
    "@uiw/react-color": "^2.10.3",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-select": "^5.10.2",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-color": "^3.1.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cmake-js": "^8.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "node-addon-api": "^8.9.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.40",
    "react-scan": "^0.5.7",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3"
  }
}
