{
  "name": "track-n-race",
  "version": "1.2.0",
  "description": "Track N Race",
  "author": "NoGoat",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.tracknrace.app",
    "productName": "Track N Race",
    "fileAssociations": [
      {
        "ext": "tnrd",
        "name": "Track N Race Session Data",
        "description": "Track N Race Recorded Telemetry Session Data",
        "role": "Viewer",
        "icon": "build/icon_transparent.ico"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon_transparent.ico",
      "extraFiles": [
        {
          "from": "native_recorder/build/Release/Track N Race Background Recorder.exe",
          "to": "Track N Race Background Recorder.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Track N Race",
      "installerIcon": "build/icon_transparent_light.ico",
      "uninstallerIcon": "build/icon_transparent_light.ico",
      "installerHeaderIcon": "build/icon_transparent_light.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-select": "^5.10.2",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.40",
    "react-scan": "^0.5.6",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3"
  }
}
